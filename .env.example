# .env.example

# --- 应用基础配置 ---
APP_NAME=MakersHub
PROJECT_NAME=MakersHub
DEBUG=True
HOST=0.0.0.0
PORT=8000
WORKERS=4
# 生产环境务必修改此密钥
SECRET_KEY=your_secret_key_here

# --- 日志配置 (已恢复) ---
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {message}
LOG_PATH=./logs/app.log

# --- 管理员后台账号 (后端 admin_router.py 依赖此配置) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
ADMIN_SECRET_KEY=your_admin_secret_key

# --- MySQL 数据库配置 ---
MYSQL_SERVER=mysql
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_DATABASE=makershub
MYSQL_ROOT_PASSWORD=rootpassword

# SQLAlchemy 连接串
# 格式: dialect+driver://username:password@host:port/database
DATABASE_URL=mysql+aiomysql://appuser:apppassword@mysql:3306/makershub

# --- MinIO 对象存储配置 ---
# 内部服务地址 (后端代码用)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# 外部访问配置
# 1. API 域名: 用于小程序/前端直接获取图片
MINIO_PUBLIC_URL=http://localhost:9000
# 2. 控制台域名: 用于管理员登录 Web 界面
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# 存储桶命名
MINIO_AVATAR_BUCKET=makershub-avatars
MINIO_POSTER_BUCKET=makershub-posters
MINIO_PUBLIC_BUCKET=makershub-public
MINIO_MATERIAL_BUCKET=makershub-materials

# --- 微信小程序配置 ---
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret

# --- JWT 认证配置 ---
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 前端专用配置 (注入给 admin-frontend 容器) ---
REACT_APP_API_URL=http://localhost:8000

# --- 跨域白名单 (CORS) ---
CORS_ORIGINS_LIST=http://localhost:3000,http://localhost:8000
